# Copy to ccdb.toml and edit. Every value has a documented default; none are secrets.
[node]
id = 1
cluster_id = "00112233445566778899aabbccddeeff"
data_dir = "./ccdb-data/n1"
listen_client = "127.0.0.1:7101"
listen_peer = "127.0.0.1:7201"
listen_metrics = "127.0.0.1:7301"

[storage]
fsync = "always"
