[Unit]
Description=Crash Course database node %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ccdb
Group=ccdb
ExecStart=/usr/local/bin/ccdb run --config /var/lib/ccdb/%i/ccdb.toml
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ccdb/%i

[Install]
WantedBy=multi-user.target
