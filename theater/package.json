{
  "name": "crash-course-theater",
  "private": true,
  "version": "0.17.0",
  "description": "Browser theater for Crash Course: a deterministic Raft cluster compiled to WebAssembly, with fault injection and timeline replay.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "check:version": "node ../scripts/check-version-coherence.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "lint": "biome lint",
    "format:check": "biome format"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@playwright/test": "1.56.1",
    "@types/react": "18.3.26",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.7.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "playwright": "1.56.1",
    "playwright-core": "1.56.1"
  }
}
